# LiDAR EPT Configuration (REQUIRED for USGS 3DEP point cloud access)
# WESM.gpkg is a 2.8GB spatial index file - download instructions in README
# Place it in data/wesm/WESM.gpkg or update path below
WESM_INDEX_PATH=data/wesm/WESM.gpkg
LIDAR_BUFFER_M=30
EPT_RESOLUTION_TARGET=1.0
DSM_RESOLUTION_M=0.5
RANSAC_RESIDUAL_M=0.3
POLYGON_SIMPLIFY_M=0.3

# Optional: Override AWS credentials (usually not needed)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Optional: Data source URLs
MS_BUILDINGS_INDEX_URL=https://minedbuildings.z5.web.core.windows.net/global-buildings/dataset-links.csv
NAIP_S3_BUCKET=naip-analytic
USGS_3DEP_API=https://s3-us-west-2.amazonaws.com/usgs-lidar-public

# Processing parameters
DEFAULT_BUFFER_METERS=150
NAIP_CLIP_PADDING_METERS=20
QUADKEY_LEVEL=9

# Output settings
OUTPUT_DIR=output
DATA_CACHE_DIR=data
