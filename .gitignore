# venv / caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# training: keep the COCO label files (small, reproducible); chips are fetched
# on the pod from S3, weights/outputs are large.
training/roof_dataset*/**/*.png
training/roof_dataset*/**/*.jpg
training/roof_dataset*/**/*.jpeg
# training-run outputs ONLY -- anchored so it does NOT match src/output/ (the
# report-generation module). A bare `output/` / `**/output/` swallows src/output.
/output/
/model_maps/
training/output/
*.pt
*.pth
*.ckpt

# generated reports / scratch data
sample_report/
*.pdf

# env / secrets (never commit real creds)
.env
*.key

# OS
.DS_Store
